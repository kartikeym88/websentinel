# Web Application Security Assessment Platform Configuration

# Target configuration
TARGET_URL=http://localhost:3000
ALLOWED_DOMAINS=localhost,127.0.0.1

# Crawler configuration
CRAWL_DEPTH=3
MAX_PAGES=100

# HTTP configuration
REQUEST_TIMEOUT=10
CONCURRENCY=5
RATE_LIMIT=10
USER_AGENT=SecurityScanner/1.0

# Paths
REPORT_DIR=reports
DATABASE_PATH=data.db
LOG_DIR=logs

# ZAP Integration
ZAP_ENABLED=false
ZAP_HOST=127.0.0.1
ZAP_PORT=8080
ZAP_API_KEY=
ZAP_TIMEOUT=300
